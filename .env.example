# --- Database -------------------------------------------------------------
# PostgreSQL connection string (production: e.g. Neon via Vercel Marketplace).
# For local development without a Postgres server you can use PGlite:
#   DATABASE_URL=pglite://.data/dev
DATABASE_URL=

# --- Authentication ---------------------------------------------------------
# Password for the single-user login page.
APP_PASSWORD=
# Random 32+ char secret used to sign the session cookie.
AUTH_SECRET=

# --- Vercel AI Gateway ------------------------------------------------------
# API key for the Vercel AI Gateway (or rely on VERCEL_OIDC_TOKEN on Vercel).
AI_GATEWAY_API_KEY=
# Gateway model IDs ("provider/model"). FAST is used for classification and
# simple generation, SMART for ambiguous conversations and escalation analysis.
AI_MODEL_FAST=minimax/minimax-m3
AI_MODEL_SMART=minimax/minimax-m3
# Vision-capable Gateway model for MMS understanding and image message drafts.
AI_MODEL_VISION=minimax/minimax-m3
# Gateway transcription model for voicemail.
AI_MODEL_TRANSCRIBE=fish-audio/transcribe-1

# --- 46elks phone number (SMS + MMS + voice) ----------------------------------
ELKS46_USERNAME=
ELKS46_PASSWORD=
ELKS46_FROM_NUMBER=

# Where escalation notifications are sent AND the ring-through target for
# incoming calls (the system owner's own phone, E.164). Can also be set per
# user in Settings.
OWNER_PHONE_NUMBER=

# Optional audio files (mp3/wav URLs) played before voicemail recording starts.
# VOICE_GREETING_URL is the default voicemail greeting; SCREEN_GREETING_URL is
# used when screening unknown callers ("What is this regarding?").
VOICE_GREETING_URL=
SCREEN_GREETING_URL=

# --- ElevenLabs (optional env fallback; can be entered encrypted in Settings) --
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional shared token for validating inbound 46elks webhooks. When set, the
# webhook URLs configured at 46elks must include ?token=<WEBHOOK_TOKEN>.
WEBHOOK_TOKEN=

# --- Scheduler ----------------------------------------------------------------
# Shared secret protecting /api/cron/dispatcher (sent by Vercel Cron as
# "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# --- App ----------------------------------------------------------------------
# Public base URL of the deployment, used in owner notification links.
APP_URL=

# Default IANA timezone used when a contact has no timezone set.
DEFAULT_TIMEZONE=Europe/Stockholm

# Set to "true" to include message previews in owner escalation SMS.
ESCALATION_PREVIEW=false
